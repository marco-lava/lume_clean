{
  "name": "sandbox-app-template",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "dev:desktop": "cd packages/desktop && bunx vite",
    "dev:mobile": "cd packages/mobile && bunx expo start",
    "build": "turbo build",
    "build:web": "cd packages/web && bunx vite build",
    "lint": "echo \"No linter configured\"",
    "lint:fix": "echo \"No linter configured\"",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push"
  },
  "devDependencies": {
    
    "@tursodatabase/api": "^1.9.2",
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "turbo": "2.9.18",
    "typescript": "7.0.1-rc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@libsql/client": "^0.17.2",
    "cloudflare": "^5.2.0"
  }
}
